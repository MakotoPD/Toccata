{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Toccata",
  "version": "0.1.0",
  "identifier": "pl.makoto.toccata",
  "build": {
    "frontendDist": "../app/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter toccata-app dev",
    "beforeBuildCommand": "pnpm --filter toccata-app generate"
  },
  "app": {
    "windows": [
      {
        "title": "Toccata",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c0b0a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
